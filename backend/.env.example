PORT=5000
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/baking_db?schema=public"
JWT_SECRET="your_secret_key_here"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Frontend URL (for CORS — comma-separated for multiple origins)
FRONTEND_URL="http://localhost:5173"

# Webhook IP Allowlist (optional — comma-separated IPs from your payment provider)
# Leave empty to skip IP check (useful for dev/testing)
# Example: WEBHOOK_ALLOWED_IPS="103.186.xx.xx,103.186.yy.yy"
WEBHOOK_ALLOWED_IPS=""

# PayOS Configuration
PAYOS_CLIENT_ID="your_client_id"
PAYOS_API_KEY="your_api_key"
PAYOS_CHECKSUM_KEY="your_checksum_key"

# SMTP Configuration for Password Reset
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM="your_email@gmail.com"
